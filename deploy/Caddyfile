{
	# O HTTPS (certificado e redirecionamento) é do Traefik, que já ocupa as portas 80 e 443 do servidor.
	# Aqui o Caddy só serve HTTP na rede interna.
	auto_https off
	servers {
		# Mantém o X-Forwarded-For que o Traefik mandou (o IP real de quem acessa), em vez de trocar pelo IP do Traefik.
		trusted_proxies static private_ranges
	}
}

(seguranca) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

http://app.{$DOMINIO}:80 {
	import seguranca
	handle_path /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}

http://admin.{$DOMINIO}:80 {
	import seguranca
	handle_path /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
