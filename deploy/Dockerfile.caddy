# Compila o sistema (web) e o backoffice e entrega os arquivos com Caddy, que também faz o HTTPS e encaminha /api para a API.
FROM node:22-slim AS build
ENV CI=true
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --filter @ecv/web... --filter @ecv/backoffice...
# A API fica no mesmo endereço do sistema, em /api: sem CORS e com o cookie de sessão no mesmo domínio.
ENV VITE_API_URL=/api
RUN pnpm --filter @ecv/shared build && pnpm --filter @ecv/web build && pnpm --filter @ecv/backoffice build

FROM caddy:2
COPY --from=build /app/apps/web/dist /srv/app
COPY --from=build /app/apps/backoffice/dist /srv/admin
COPY deploy/Caddyfile /etc/caddy/Caddyfile
