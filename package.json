{
  "name": "ecv-cash",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @ecv/api db:migrate",
    "db:seed": "pnpm --filter @ecv/api db:seed",
    "dev:api": "pnpm --filter @ecv/api dev",
    "dev:web": "pnpm --filter @ecv/web dev",
    "dev:backoffice": "pnpm --filter @ecv/backoffice dev",
    "e2e": "tsx e2e/smoke.ts"
  }
}
